# Keys for discover/analyze/upload; keep these out of Git commits.
YOUTUBE_API_KEY=
GEMINI_API_KEY=
YOUTUBE_OAUTH_TOKEN=

# GTA 6 only. Video title filter is also hard enforced in code.
SEARCH_TERMS=GTA 6 live,GTA VI gameplay,GTA 6 shorts
REGION_CODES=US,IN,GB,JP,BR
MIN_SUBSCRIBERS=1000000
MIN_LONG_SECONDS=36000
MAX_SEARCH_CALLS_PER_RUN=3
MAX_VIDEOS_PER_RUN=8
TARGET_CLIPS_PER_VIDEO=8
MAX_CLIPS_PER_VIDEO=9
MIN_SUPPORT=2
MIN_SCORE=0.35
MAX_API_COMMENTS=200
MAX_GEMINI_EVALUATIONS_PER_RUN=2

# 20s pre-highlight + 10s after = 30-second vertical clips
CLIP_LEAD_SECONDS=20
CLIP_AFTER_SECONDS=10
OUTPUT_FORMAT=vertical

# yt_dlp: download only selected video segments (not full 10-hour file).
# provided: only use MEDIA_DIR or MEDIA_SOURCE_MAP_JSON, no yt-dlp.
SOURCE_MODE=yt_dlp
MEDIA_DIR=media
MEDIA_SOURCE_MAP_JSON={}
OUTPUT_DIR=output
LIVE_CHAT_DELAY_SECONDS=0

# Keep only free-tier candidates YOU verify for your Gemini project.
FREE_MODEL_CANDIDATES=gemini-2.5-flash-lite,gemini-2.5-flash,gemini-3-flash-preview

# OAuth is necessary to enable upload to YOUR channel.
AUTO_UPLOAD=false
UPLOAD_PRIVACY=private
STATE_PATH=state/processed.json
REPORT_PATH=reports/latest.json

# Every workflow begins with a CURRENTLY LIVE search, not just a normal search.
LIVE_SEARCH_TERM=GTA 6 gameplay live
LIVE_CAPTURE_ENABLED=true
LIVE_CAPTURE_SECONDS=150
MAX_LIVE_CAPTURES_PER_RUN=1
LIVE_POLLS=6
LIVE_POLL_SECONDS=20
# Adjust after testing chat-vs-video latency; positive shifts clips forward.
LIVE_CLOCK_SHIFT_SECONDS=0
